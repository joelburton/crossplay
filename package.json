{
  "name": "crossplay",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace=@crossplay/server",
    "dev:client": "npm run dev --workspace=@crossplay/client",
    "build": "npm run build --workspaces --if-present",
    "start": "npm run start --workspace=@crossplay/server",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
