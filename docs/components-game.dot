// React render tree for Crossplay's board route ("/b/:id").
// Render with: dot -Tpng docs/components-game.dot -o docs/components-game.png
//
// Edges are parent → child render relationships. Dashed edges mark
// conditional renders (load state, panel-open flag, transient overlay).
// Hooks and pure helpers (cursor.ts, chatIdentity.ts, draggablePanel.ts,
// linkify.tsx, previewText.ts, useBoardSocket.ts) are intentionally
// omitted — this is a render tree, not a module graph.

digraph CrossplayGame {
  rankdir=TB;
  splines=true;
  nodesep=0.4;
  ranksep=0.5;
  bgcolor="white";
  node [
    shape=box,
    style="rounded,filled",
    fontname="Helvetica",
    fontsize=11,
    color="#444",
    penwidth=1
  ];
  edge [color="#666", arrowsize=0.7];

  // Top-level shell
  App           [fillcolor="#e3eefc"];

  // Board-route header chrome (App renders these only on /b/:id; the
  // home route uses a separate hero header inside HomePage instead)
  SiteIcon      [fillcolor="#f6f6f6"];
  Menu          [fillcolor="#f6f6f6"];
  ModeButton    [fillcolor="#f6f6f6"];
  FeedbackBar   [fillcolor="#f6f6f6"];

  // Route-level views shown on /b/:id
  PuzzleView    [fillcolor="#dff5e1"];
  UploadForm    [fillcolor="#f6f6f6"];

  // PuzzleView's children
  Board            [fillcolor="#dff5e1"];
  Cell             [fillcolor="#dff5e1"];
  RebusInput       [fillcolor="#dff5e1"];
  ClueList         [fillcolor="#dff5e1"];
  ChatIndicator    [fillcolor="#fde0e0"];
  ChatPreview      [fillcolor="#fde0e0"];
  ChatPanel        [fillcolor="#fde0e0"];
  NoteDialog       [fillcolor="#ecdcfb"];
  HelpDialog       [fillcolor="#ecdcfb"];
  NumberJumpDialog [fillcolor="#ecdcfb"];

  // Header chrome: always rendered on this route
  App -> SiteIcon;
  App -> Menu;
  App -> ModeButton  [style=dashed, label="loaded"];
  App -> FeedbackBar;

  // Body: load state branches
  App -> PuzzleView [style=dashed, label="loaded"];
  App -> UploadForm [style=dashed, label="load error"];

  // PuzzleView's render tree
  PuzzleView -> Board;
  PuzzleView -> ClueList    [label="across + down"];
  PuzzleView -> ChatIndicator;
  PuzzleView -> ChatPreview [style=dashed, label="recent msg"];
  PuzzleView -> ChatPanel   [style=dashed, label="chat open"];
  PuzzleView -> NoteDialog       [style=dashed, label="notes open"];
  PuzzleView -> HelpDialog       [style=dashed, label="help open"];
  PuzzleView -> NumberJumpDialog [style=dashed, label="# popup open"];

  Board -> Cell       [label="N×M"];
  Board -> RebusInput [style=dashed, label="rebus open"];

  // Layout hints
  { rank=same; SiteIcon; Menu; ModeButton; FeedbackBar; }
  { rank=same; PuzzleView; UploadForm; }
  { rank=same; ChatIndicator; ChatPreview; ChatPanel; NoteDialog; HelpDialog; NumberJumpDialog; }
}
